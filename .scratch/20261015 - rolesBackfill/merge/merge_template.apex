// Duplicate-contact merge, one chunk (generated by make_chunks.py). Per group: re-read the relations, give the master the
// union of the roles and (when it has none) the loser's real platform id + checkboxes, then merge. A group whose state
// differs from the plan (contact gone, other account, two real ids) is skipped. Output: one RESULT line per group.
String planJson = '__PLAN__';
List<Object> plan = (List<Object>) JSON.deserializeUntyped(planJson);
List<String> out = new List<String>();
for (Object o : plan) {
	Map<String, Object> grp = (Map<String, Object>) o;
	Id accountId = (Id) grp.get('account');
	Id masterId = (Id) grp.get('master');
	List<Id> loserIds = new List<Id>();
	for (Object l : (List<Object>) grp.get('losers')) {
		loserIds.add((Id) l);
	}
	Savepoint sp = Database.setSavepoint();
	try {
		Set<Id> all = new Set<Id>(loserIds);
		all.add(masterId);
		Map<Id, Contact> contacts = new Map<Id, Contact>([SELECT Id, AccountId, Email FROM Contact WHERE Id IN :all]);
		if (contacts.size() != all.size()) { out.add('SKIP|' + masterId + '|contact missing'); continue; }
		for (Contact c : contacts.values()) {
			if (c.AccountId != accountId) { throw new IllegalArgumentException('contact on another account: ' + c.Id); }
		}
		Map<Id, AccountContactRelation> acrByContact = new Map<Id, AccountContactRelation>();
		for (AccountContactRelation acr : [SELECT Id, ContactId, Roles,
				extId_1__c, extId_2__c, extId_3__c, extId_4__c, extId_5__c, extId_6__c,
				isAdministrator_1__c, isAdministrator_2__c, isAdministrator_3__c, isAdministrator_4__c, isAdministrator_5__c, isAdministrator_6__c,
				isVisible_1__c, isVisible_2__c, isVisible_3__c, isVisible_4__c, isVisible_5__c, isVisible_6__c
				FROM AccountContactRelation WHERE AccountId = :accountId AND ContactId IN :all]) {
			acrByContact.put(acr.ContactId, acr);
		}
		AccountContactRelation master = acrByContact.get(masterId);
		if (master == null) { out.add('SKIP|' + masterId + '|master has no relation'); continue; }
		List<String> roles = String.isBlank(master.Roles) ? new List<String>() : master.Roles.split(';');
		AccountContactRelation masterUpd = new AccountContactRelation(Id = master.Id);
		List<AccountContactRelation> loserUpds = new List<AccountContactRelation>();
		Boolean masterChanged = false;
		for (Id lid : loserIds) {
			AccountContactRelation l = acrByContact.get(lid);
			if (l == null) { continue; }
			if (String.isNotBlank(l.Roles)) {
				for (String r : l.Roles.split(';')) {
					if (String.isNotBlank(r) && !roles.contains(r)) { roles.add(r); masterChanged = true; }
				}
			}
			AccountContactRelation lu = new AccountContactRelation(Id = l.Id);
			Boolean loserChanged = false;
			for (Integer p = 1; p <= 6; p++) {
				String lExt = (String) l.get('extId_' + p + '__c');
				String mExt = (String) master.get('extId_' + p + '__c');
				if (String.isNotBlank(lExt) && !lExt.endsWith('a')) {
					if (String.isNotBlank(mExt) && !mExt.endsWith('a')) {
						throw new IllegalArgumentException('two real platform ids on platform ' + p);
					}
					lu.put('extId_' + p + '__c', null);
					masterUpd.put('extId_' + p + '__c', lExt);
					masterUpd.put('isAdministrator_' + p + '__c', l.get('isAdministrator_' + p + '__c'));
					masterUpd.put('isVisible_' + p + '__c', l.get('isVisible_' + p + '__c'));
					loserChanged = true;
					masterChanged = true;
				}
			}
			if (loserChanged) { loserUpds.add(lu); }
		}
		// merge first: it deletes the losers' relations on this account, so the real platform id (unique extId_N__c) is
		// free when the master's relation takes it over (clearing it on the loser first still collided, prod 2026-10-15)
		Contact masterContact = new Contact(Id = masterId);
		for (Integer i = 0; i < loserIds.size(); i += 2) {
			List<Id> batch = new List<Id>{ loserIds[i] };
			if (i + 1 < loserIds.size()) { batch.add(loserIds[i + 1]); }
			Database.merge(masterContact, batch);
		}
		if (masterChanged) {
			masterUpd.Roles = String.join(roles, ';');
			update masterUpd;
		}
		out.add('OK|' + masterId + '|' + String.join(loserIds, ',') + '|' + String.join(roles, ';'));
	} catch (Exception e) {
		Database.rollback(sp);
		out.add('FAIL|' + masterId + '|' + e.getMessage().replace('\n', ' ').left(200));
	}
}
for (String line : out) { System.debug('RESULT ' + line); }
