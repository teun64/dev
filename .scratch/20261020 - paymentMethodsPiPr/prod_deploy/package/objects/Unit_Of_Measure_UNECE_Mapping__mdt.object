<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Maps Product2.QuantityUnitOfMeasure values to UN/ECE Recommendation 20 unit codes, for EN 16931 e-invoicing (BT-130).</description>
    <label>Unit Of Measure UNECE Mapping</label>
    <pluralLabel>Unit Of Measure UNECE Mappings</pluralLabel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Internal_Unit__c</fullName>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>Internal Unit</label>
        <type>Text</type>
        <length>40</length>
        <required>true</required>
        <description>Value from Product2.QuantityUnitOfMeasure (e.g. Hour(s), Month(s), Piece(s)).</description>
    </fields>
    <fields>
        <fullName>UNECE_Code__c</fullName>
        <fieldManageability>SubscriberControlled</fieldManageability>
        <label>UNECE Code</label>
        <type>Text</type>
        <length>3</length>
        <required>true</required>
        <description>UN/ECE Recommendation 20 unit of measure code (e.g. HUR, MON, C62) for BT-130.</description>
    </fields>
</CustomObject>
