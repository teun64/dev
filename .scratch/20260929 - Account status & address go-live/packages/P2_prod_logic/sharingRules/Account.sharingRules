<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>sr_Accounts_CustomerBase_DE</fullName>
        <accessLevel>Edit</accessLevel>
        <accountSettings>
            <caseAccessLevel>Edit</caseAccessLevel>
            <contactAccessLevel>Edit</contactAccessLevel>
            <opportunityAccessLevel>Edit</opportunityAccessLevel>
        </accountSettings>
        <label>Accounts - Customer Base - DE (sr)</label>
        <sharedTo>
            <roleAndSubordinatesInternal>rg_miCustomerBaseDE_Management</roleAndSubordinatesInternal>
        </sharedTo>
        <criteriaItems>
            <field>Reseller_Name__c</field>
            <operation>equals</operation>
            <value>DE - Moving Intelligence GmbH</value>
        </criteriaItems>
        <criteriaItems>
            <field>Status__c</field>
            <operation>notEqual</operation>
            <value>deactivated</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
