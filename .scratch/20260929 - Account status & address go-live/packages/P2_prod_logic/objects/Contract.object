<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>Name_Display__c</fullName>
        <description>Platform Picto &amp; Name for display purposes only</description>
        <externalId>false</externalId>
        <formula>TRIM(IF(ISBLANK( TEXT(System_Platform__c) ), &apos;&apos;, IMAGE(&apos;/resource/systemIcons/&apos; + TEXT(System_Platform__c) + &apos;.svg&apos;,  TEXT(System_Platform__c)  , 20, 20)) + &apos;  &apos; + BLANKVALUE(ContractNumber, &apos;&apos;) + &apos;(&apos; + BLANKVALUE(Name,&apos;?&apos;) + &apos;)&apos;)</formula>
        <label>Name (Display)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Source__c</fullName>
        <description>Picto representing the platform</description>
        <externalId>false</externalId>
        <formula>IMAGE(&apos;/resource/systemIcons/&apos; + TEXT(System_Platform__c) + &apos;.svg&apos;,  TEXT(System_Platform__c)  , 24, 24)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Source</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>
