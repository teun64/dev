<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>FinancialIdInvoiceAddress__c</fullName>
        <description>The Financial Id (Exact) of the invoice address (InvoiceAddress__c). Plain text: the external-id/unique limit (25) on Account is reached in acc.</description>
        <externalId>false</externalId>
        <label>Id (Invoice Address)</label>
        <length>40</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>InvoiceAddress__c</fullName>
        <businessStatus>Active</businessStatus>
        <description>Address the invoice is sent to (by post). Equals the Establishment / Billing Address unless useInvoiceAddress__c is set (copied by rbb_Account).</description>
        <inlineHelpText>Address the invoice is sent to (by post). Only differs from the Establishment / Billing Address when &quot;Use different Invoice Address&quot; is set.</inlineHelpText>
        <label>Invoice Address</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Address</type>
    </fields>
    <fields>
        <fullName>InvoiceAddress_Country__c</fullName>
        <description>Workaround, stores the label of the InvoiceAddress__c country code picklist (set by Trigger_Account)</description>
        <externalId>false</externalId>
        <label>Invoice Address (Country)</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>InvoiceAddress_State__c</fullName>
        <description>Workaround, stores the label of the InvoiceAddress__c state code picklist (set by Trigger_Account)</description>
        <externalId>false</externalId>
        <label>Invoice Address (State)</label>
        <length>255</length>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>StatusChangedBy__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>User who made the last Status__c change. Set by rbb_Account (together with StatusPrevious__c and StatusChangedOn__c).</description>
        <label>Changed By (Status)</label>
        <referenceTo>User</referenceTo>
        <relationshipName>StatusChangedBy</relationshipName>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>StatusPrevious__c</fullName>
        <description>Status__c value before the last status change. Set by rbb_Account (together with StatusChangedOn__c).</description>
        <label>Previous (Status)</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>pvs_AccountStatus</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>useInvoiceAddress__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicator for a different invoice address: when true the Invoice Address can be set, when false it equals the Establishment / Billing Address (copied by rbb_Account). Replaces useBillingAddress__c.</description>
        <label>Use different Invoice Address</label>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
