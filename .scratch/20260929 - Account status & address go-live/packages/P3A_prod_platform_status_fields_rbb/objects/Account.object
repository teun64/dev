    <fields>
        <fullName>HealthList24__c</fullName>
        <description>Picto list representing the plaforms size 24 pix (list view purpose)</description>
        <externalId>false</externalId>
        <formula>TRIM(
IF(ISBLANK(Text(Status__c)),&apos;&apos;,IMAGE(&apos;/resource/accountStatus/&apos;+Text(Status__c)+&apos;.svg&apos;,Text(Status__c), 24, 24)) + &apos; &apos;
+ IF(OR(ISBLANK( extId_1__c ), ISPICKVAL(extStatus_1__c, &apos;ended&apos;)),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/1&apos;+IF(AND(NOT(ISBLANK(TEXT(extStatus_1__c))), NOT(ISPICKVAL(extStatus_1__c, &apos;active&apos;))),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_1__c, 24, 24)) + &apos; &apos;
+ IF(OR(ISBLANK( extId_2__c ), ISPICKVAL(extStatus_2__c, &apos;ended&apos;)),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/2&apos;+IF(AND(NOT(ISBLANK(TEXT(extStatus_2__c))), NOT(ISPICKVAL(extStatus_2__c, &apos;active&apos;))),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_2__c, 24, 24)) + &apos; &apos;
+ IF(OR(ISBLANK( extId_3__c ), ISPICKVAL(extStatus_3__c, &apos;ended&apos;)),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/3&apos;+IF(AND(NOT(ISBLANK(TEXT(extStatus_3__c))), NOT(ISPICKVAL(extStatus_3__c, &apos;active&apos;))),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_3__c, 24, 24)) + &apos; &apos;
+ IF(OR(ISBLANK( extId_4__c ), ISPICKVAL(extStatus_4__c, &apos;ended&apos;)),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/4&apos;+IF(AND(NOT(ISBLANK(TEXT(extStatus_4__c))), NOT(ISPICKVAL(extStatus_4__c, &apos;active&apos;))),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_4__c, 24, 24)) + &apos; &apos;
+ IF(OR(ISBLANK( extId_5__c ), ISPICKVAL(extStatus_5__c, &apos;ended&apos;)),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/5&apos;+IF(AND(NOT(ISBLANK(TEXT(extStatus_5__c))), NOT(ISPICKVAL(extStatus_5__c, &apos;active&apos;))),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_5__c, 24, 24)) + &apos; &apos;
+ IF(OR(ISBLANK( extId_6__c ), ISPICKVAL(extStatus_6__c, &apos;ended&apos;)),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/6&apos;+IF(AND(NOT(ISBLANK(TEXT(extStatus_6__c))), NOT(ISPICKVAL(extStatus_6__c, &apos;active&apos;))),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_6__c, 24, 24))
)</formula>
        <label>Health (24)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
