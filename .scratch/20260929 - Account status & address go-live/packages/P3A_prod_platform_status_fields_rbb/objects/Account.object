+ IF(AND(NOT(ISBLANK( extId_5__c )), NOT(ISPICKVAL(extStatus_5__c, &apos;ended&apos;))),&apos;|5|&apos; + extId_5__c,&apos;&apos;)
+ IF(AND(NOT(ISBLANK( extId_6__c )), NOT(ISPICKVAL(extStatus_6__c, &apos;ended&apos;))),&apos;|6|&apos; + extId_6__c,&apos;&apos;)
+ IF(OR(AND(NOT(ISBLANK( extId_1__c )), NOT(ISPICKVAL(extStatus_1__c, &apos;ended&apos;))), AND(NOT(ISBLANK( extId_2__c )), NOT(ISPICKVAL(extStatus_2__c, &apos;ended&apos;))), AND(NOT(ISBLANK( extId_3__c )), NOT(ISPICKVAL(extStatus_3__c, &apos;ended&apos;))), AND(NOT(ISBLANK( extId_4__c )), NOT(ISPICKVAL(extStatus_4__c, &apos;ended&apos;))), AND(NOT(ISBLANK( extId_5__c )), NOT(ISPICKVAL(extStatus_5__c, &apos;ended&apos;))), AND(NOT(ISBLANK( extId_6__c )), NOT(ISPICKVAL(extStatus_6__c, &apos;ended&apos;)))),&apos;|&apos;,&apos;&apos;)</formula>
