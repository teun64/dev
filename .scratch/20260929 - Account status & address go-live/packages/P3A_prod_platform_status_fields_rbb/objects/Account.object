    <fields>
        <fullName>Platform_IDs__c</fullName>
        <description>Representation of all the platformID&apos;s</description>
        <externalId>false</externalId>
        <formula>IF(AND(NOT(ISBLANK( extId_1__c )), NOT(ISPICKVAL(extStatus_1__c, &apos;ended&apos;))),&apos;|1|&apos; + extId_1__c,&apos;&apos;)
