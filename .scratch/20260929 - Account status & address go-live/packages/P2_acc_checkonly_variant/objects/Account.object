<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <compactLayouts>
        <fullName>mi_as_B2C</fullName>
        <fields>Exact_Account_Name__c</fields>
        <fields>BillingAddress</fields>
        <fields>Billing_Email__c</fields>
        <fields>FinancialDebtorNumber__c</fields>
        <fields>HealthList24__c</fields>
        <fields>RecordTypeId</fields>
        <fields>Market__c</fields>
        <fields>StatusIcon__c</fields>
        <fields>Subscriptions_Activated__c</fields>
        <fields>First_Subscription_Date__c</fields>
        <label>B2C - After sales</label>
    </compactLayouts>
    <fields>
        <fullName>Block_Syncing_Exact__c</fullName>
        <description>Field to unlink WSONE app from all the code execution, does the check in a formula (insted of code)</description>
        <formula>AND(
    OR(
        (RecordType.DeveloperName = &apos;B2C&apos;),
        AND(
            (RecordType.DeveloperName &lt;&gt; &apos;B2C&apos;),
            NOT(
                AND(
                    OR(
                        AND( 
                            (TEXT(BillingCountryCode) &lt;&gt; &apos;NL&apos;),
                            NOT(ISBLANK(TEXT(BillingCountryCode)))
                        )
                        ,
                        AND(
                            (TEXT(BillingCountryCode) = &apos;NL&apos;),
                            (WSONE_DATA__DutchBusinessValidationStatus__c = &apos;VALIDATED&apos;)
                        )
                    ),
                    NOT(
                        ISBLANK(CoC_Number__c)
                    ),
                    OR(
                        ISNUMBER(CoC_Number__c),
                        (CoC_Number__c = &apos;-&apos;)
                    ),
                    (CoC_Number_Confirmation_Required__c = CoC_Number_Confirmation__c),
                    NOT(
                        ISBLANK(VAT_Number__c)
                    ),
                    (VAT_Number_Confirmation_Required__c = VAT_Number_Confirmation__c)
                )
            )
        )
    )
    ,
    AND(ISBLANK(BillingStreet), ISBLANK(BillingCity), ISBLANK(BillingPostalCode), ISBLANK(TEXT(BillingCountryCode)))
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <inlineHelpText>Block Syncing to exact is TRUE when this account is not validated and checked by WSONE, the supplied COC Number is valid and a VAT Number is supplied.</inlineHelpText>
        <label>Block Syncing Financial System</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>HealthList24__c</fullName>
        <description>Picto list representing the plaforms size 24 pix (list view purpose)</description>
        <externalId>false</externalId>
        <formula>TRIM(
IF(ISBLANK(Text(Status__c)),&apos;&apos;,IMAGE(&apos;/resource/accountStatus/&apos;+Text(Status__c)+&apos;.svg&apos;,Text(Status__c), 24, 24)) + &apos; &apos;
+ IF(ISBLANK( extId_1__c ),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/1&apos;+IF(NOT(ISPICKVAL(Status__c, &apos;active&apos;)),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_1__c, 24, 24)) + &apos; &apos;
+ IF(ISBLANK( extId_2__c ),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/2&apos;+IF(NOT(ISPICKVAL(Status__c, &apos;active&apos;)),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_2__c, 24, 24)) + &apos; &apos;
+ IF(ISBLANK( extId_3__c ),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/3&apos;+IF(NOT(ISPICKVAL(Status__c, &apos;active&apos;)),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_3__c, 24, 24)) + &apos; &apos;
+ IF(ISBLANK( extId_4__c ),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/4&apos;+IF(NOT(ISPICKVAL(Status__c, &apos;active&apos;)),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_4__c, 24, 24)) + &apos; &apos;
+ IF(ISBLANK( extId_5__c ),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/5&apos;+IF(NOT(ISPICKVAL(Status__c, &apos;active&apos;)),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_5__c, 24, 24)) + &apos; &apos;
+ IF(ISBLANK( extId_6__c ),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/6&apos;+IF(NOT(ISPICKVAL(Status__c, &apos;active&apos;)),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_6__c, 24, 24))
)</formula>
        <label>Health (24)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
