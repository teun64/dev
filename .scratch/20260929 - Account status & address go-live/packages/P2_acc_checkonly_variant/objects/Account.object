+ IF(ISBLANK( extId_1__c ),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/1&apos;+IF(NOT(ISPICKVAL(Status__c, &apos;active&apos;)),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_1__c, 48, 48)) + &apos; &apos;
+ IF(ISBLANK( extId_2__c ),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/2&apos;+IF(NOT(ISPICKVAL(Status__c, &apos;active&apos;)),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_2__c, 48, 48)) + &apos; &apos;
+ IF(ISBLANK( extId_3__c ),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/3&apos;+IF(NOT(ISPICKVAL(Status__c, &apos;active&apos;)),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_3__c, 48, 48)) + &apos; &apos;
+ IF(ISBLANK( extId_4__c ),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/4&apos;+IF(NOT(ISPICKVAL(Status__c, &apos;active&apos;)),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_4__c, 48, 48)) + &apos; &apos;
+ IF(ISBLANK( extId_5__c ),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/5&apos;+IF(NOT(ISPICKVAL(Status__c, &apos;active&apos;)),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_5__c, 48, 48)) + &apos; &apos;
+ IF(ISBLANK( extId_6__c ),&apos;&apos;,IMAGE(&apos;/resource/systemIcons/6&apos;+IF(NOT(ISPICKVAL(Status__c, &apos;active&apos;)),&apos;_disabled&apos;,&apos;&apos;)+&apos;.svg&apos;, extId_6__c, 48, 48))
