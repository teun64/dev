    <fields>
        <fullName>StatusIcon__c</fullName>
        <description>Health of the account (customer): icon + label of Status__c (pvs_AccountStatus). Icons: static resource accountStatus/&lt;status&gt;.svg</description>
        <externalId>false</externalId>
        <formula>IF(ISBLANK(TEXT(Status__c)), &apos;&apos;,
IMAGE(&apos;/resource/accountStatus/&apos; &amp; TEXT(Status__c) &amp; &apos;.svg&apos;, TEXT(Status__c), 20, 20)
&amp; &apos; &apos; &amp;
CASE(Status__c,
    &apos;active&apos;, &apos;Active&apos;,
    &apos;blocked&apos;, &apos;Blocked&apos;,
    &apos;defaulter&apos;, &apos;Defaulter&apos;,
    &apos;ended&apos;, &apos;Ended&apos;,
    &apos;bankrupt&apos;, &apos;Bankrupt&apos;,
    &apos;deactivated&apos;, &apos;Deactivated&apos;,
    &apos;&apos;)
)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Icon (Status)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>
