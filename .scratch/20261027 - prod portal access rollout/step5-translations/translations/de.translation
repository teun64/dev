        <label>Wir haben eine Anfrage erhalten, ein neues Passwort für Ihr Dealer-Portal-Konto festzulegen.</label>
        <name>DealerPortal_EmailResetIntro</name>
    </customLabels>
    <customLabels>
        <label>Neues Passwort wählen</label>
        <name>DealerPortal_EmailResetButton</name>
