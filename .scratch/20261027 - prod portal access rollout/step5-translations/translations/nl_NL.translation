    <customLabels>
        <label>Beste {0},</label>
        <name>DealerPortal_EmailGreeting</name>
    </customLabels>
    <customLabels>
        <label>Er is een account voor je aangemaakt op het Moving Intelligence Dealer Portal. In het portal kun je producten bestellen en je bestellingen bekijken.</label>
        <name>DealerPortal_EmailWelcomeIntro</name>
    </customLabels>
    <customLabels>
        <label>Je logt in met je e-mailadres: {0}</label>
        <name>DealerPortal_EmailLoginHint</name>
    </customLabels>
