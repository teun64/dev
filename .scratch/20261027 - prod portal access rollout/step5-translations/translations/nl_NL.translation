        <label>Stel je wachtwoord in</label>
        <name>DealerPortal_EmailWelcomeButton</name>
    </customLabels>
    <customLabels>
        <label>Deze knop werkt één keer. Is hij verlopen? Gebruik dan "Wachtwoord vergeten?" op de inlogpagina.</label>
        <name>DealerPortal_EmailLinkHint</name>
    </customLabels>
    <customLabels>
        <label>Vragen? Neem contact met ons op via {0}.</label>
        <name>DealerPortal_EmailQuestions</name>
    </customLabels>
