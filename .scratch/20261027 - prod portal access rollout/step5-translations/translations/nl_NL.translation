    <customLabels>
        <label>Ik ga ermee akkoord dat Moving Intelligence deze betaalmethode mag gebruiken om alle toekomstige abonnementsbetalingen automatisch te innen.</label>
        <name>PaymentCheckoutFutureConsentLabel</name>
    </customLabels>
    <customLabels>
        <label>Bevestig dat toekomstige abonnementsbetalingen automatisch met deze betaalmethode mogen worden geïnd voordat u doorgaat.</label>
        <name>PaymentCheckoutFutureConsentRequired</name>
    </customLabels>
    <customLabels>
        <label>Welkom bij het Moving Intelligence Dealer Portal</label>
