    <customLabels>
        <label>J'accepte que Moving Intelligence utilise ce moyen de paiement pour collecter automatiquement tous les futurs paiements d'abonnement.</label>
        <name>PaymentCheckoutFutureConsentLabel</name>
    </customLabels>
    <customLabels>
        <label>Veuillez confirmer que les futurs paiements d'abonnement peuvent être prélevés automatiquement avec ce moyen de paiement avant de continuer.</label>
        <name>PaymentCheckoutFutureConsentRequired</name>
    </customLabels>
    <customLabels>
        <label>Bienvenue sur le Dealer Portal de Moving Intelligence</label>
        <name>DealerPortal_EmailWelcomeSubject</name>
    </customLabels>
    <customLabels>
        <label>Bonjour {0},</label>
        <name>DealerPortal_EmailGreeting</name>
    </customLabels>
    <customLabels>
        <label>Un compte a été créé pour vous sur le Dealer Portal de Moving Intelligence. Sur le portail, vous pouvez commander des produits et consulter vos commandes.</label>
        <name>DealerPortal_EmailWelcomeIntro</name>
    </customLabels>
    <customLabels>
        <label>Vous vous connectez avec votre adresse e-mail : {0}</label>
        <name>DealerPortal_EmailLoginHint</name>
    </customLabels>
    <customLabels>
        <label>Définir votre mot de passe</label>
        <name>DealerPortal_EmailWelcomeButton</name>
    </customLabels>
    <customLabels>
        <label>Ce bouton ne fonctionne qu’une fois. Il a expiré ? Utilisez « Mot de passe oublié ? » sur la page de connexion.</label>
        <name>DealerPortal_EmailLinkHint</name>
    </customLabels>
    <customLabels>
        <label>Des questions ? Contactez-nous à {0}.</label>
        <name>DealerPortal_EmailQuestions</name>
    </customLabels>
