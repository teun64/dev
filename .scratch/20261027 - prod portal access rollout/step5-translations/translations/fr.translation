        <label>Cordialement,</label>
        <name>DealerPortal_EmailSignature</name>
    </customLabels>
    <customLabels>
        <label>Votre nouveau mot de passe Dealer Portal</label>
        <name>DealerPortal_EmailResetSubject</name>
    </customLabels>
    <customLabels>
        <label>Nous avons reçu une demande de nouveau mot de passe pour votre compte Dealer Portal.</label>
        <name>DealerPortal_EmailResetIntro</name>
    </customLabels>
    <customLabels>
        <label>Choisir un nouveau mot de passe</label>
        <name>DealerPortal_EmailResetButton</name>
    </customLabels>
    <customLabels>
        <label>Vous n’êtes pas à l’origine de cette demande ? Ignorez simplement cet e-mail ; votre mot de passe reste inchangé.</label>
