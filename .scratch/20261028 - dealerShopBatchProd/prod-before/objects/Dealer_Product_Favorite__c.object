    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>One row per user (portal or internal) marking a Product2 as a favorite. Accessed only via Ctrl_DealerShop (AccessLevel.SYSTEM_MODE), so no CRUD/FLS grants are required on the Dealer Portal permission set.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Product__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Product</label>
        <referenceTo>Product2</referenceTo>
        <relationshipLabel>Dealer Product Favorites</relationshipLabel>
        <relationshipName>Dealer_Product_Favorites</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>User__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>User</label>
        <referenceTo>User</referenceTo>
        <relationshipLabel>Dealer Product Favorites</relationshipLabel>
        <relationshipName>Dealer_Product_Favorites_User</relationshipName>
        <required>false</required>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <label>Dealer Product Favorite</label>
    <nameField>
        <displayFormat>DPF-{0000000}</displayFormat>
        <label>Dealer Product Favorite Name</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Dealer Product Favorites</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
