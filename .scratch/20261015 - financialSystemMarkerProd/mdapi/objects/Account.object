<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>FinancialSyncForce__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Set (once, at the financial system go-live) on accounts whose Exact data may be out of date. The account is then pushed in full before its next order sync and before its next invoice (Batch_FinancialSystemForceSync, invoice due within a few days). Any successful account sync (button, batch) clears it; false = assumed in sync with Exact.</description>
        <externalId>false</externalId>
        <inlineHelpText>Checked: the account is synchronised in full with Exact before its next order or invoice. Cleared automatically after a successful Exact sync.</inlineHelpText>
        <label>Exact Sync before Order/Invoice</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>FinancialSystemLastSyncDate__c</fullName>
        <description>Moment of the last successful sync of this account to the financial system (Exact) by the new financial sync (Util_FinancialSystemAccount).</description>
        <externalId>false</externalId>
        <label>Exact Last Sync Date</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
</CustomObject>
