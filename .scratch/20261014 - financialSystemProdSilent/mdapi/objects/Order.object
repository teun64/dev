<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>FinancialSyncAttempts__c</fullName>
        <description>Failed financial system sync attempts in a row; drives the retry back-off (FinancialSyncNextAttempt__c). Reset after a successful sync.</description>
        <externalId>false</externalId>
        <label>Financial Sync Attempts</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>FinancialSyncBlocked__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Financial system sync stopped after repeated hard (data) failures (Svc_FinancialSystemSyncAlert.HARD_FAILURE_LIMIT); the batch skips it until the data is corrected and the sync is restarted. Technical failures never block.</description>
        <externalId>false</externalId>
        <inlineHelpText>The Exact sync stopped because the same data problem failed several times (see Financial Sync Last Error). Correct it and use &quot;Sync to Exact (new)&quot;.</inlineHelpText>
        <label>Exact Sync Blocked</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>FinancialSyncHardFailures__c</fullName>
        <description>Hard (data) failures of the financial system sync since the last success or restart; at Svc_FinancialSystemSyncAlert.HARD_FAILURE_LIMIT the record is blocked (FinancialSyncBlocked__c). Technical failures are not counted.</description>
        <externalId>false</externalId>
        <label>Financial Sync Hard Failures</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>FinancialSyncLastError__c</fullName>
        <description>Last financial system sync error for this order (empty after a successful sync). Details in Event_Log__c / OAuth_Log__c.</description>
        <externalId>false</externalId>
        <label>Financial Sync Last Error</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>FinancialSyncNextAttempt__c</fullName>
        <description>After a failed financial system sync: the batch does not retry the order before this moment (exponential back-off).</description>
        <externalId>false</externalId>
        <label>Financial Sync Next Attempt</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>FinancialSystemIdWarehouse__c</fullName>
        <description>Financial system (Exact) warehouse of this order. One warehouse per order: afl_Opportuntity_Create_Order creates one order per warehouse (Exact allows one warehouse per sales order).</description>
        <inlineHelpText>Warehouse this order ships from (one per order).</inlineHelpText>
        <label>Warehouse</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>pvs_FinancialSystemWarehouse</valueSetName>
        </valueSet>
    </fields>
    <fields>
        <fullName>SyncToFinancialSystem__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Set by the user&apos;s &quot;sync to financial system&quot; action: Batch_FinancialSystemOrderSync creates the sales order in the financial system (Exact), stores Exact_Id__c / Exact_Order_Number__c, activates the order and clears this flag. The order waits while its account is not in the financial system yet.</description>
        <inlineHelpText>The order is waiting to be created in the financial system (Exact).</inlineHelpText>
        <label>Sync To Financial System</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <listViews>
        <fullName>Exact_Sync_Blocked</fullName>
        <columns>ORDERS.ORDER_NUMBER</columns>
        <columns>SALES.ACCOUNT.NAME</columns>
        <columns>ORDERS.STATUS</columns>
        <columns>FinancialSyncLastError__c</columns>
        <columns>FinancialSyncHardFailures__c</columns>
        <columns>ORDERS.EFFECTIVE_DATE</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>FinancialSyncBlocked__c</field>
            <operation>equals</operation>
            <value>1</value>
        </filters>
        <label>Exact sync blocked</label>
    </listViews>
</CustomObject>
