<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>FinancialSystemIdWarehouse__c</fullName>
        <description>Financial system (Exact) warehouse this product ships from in this administration. Empty = the administration default (Warehouse (Default)). Orders are split per warehouse (Exact allows one warehouse per sales order). Must belong to the administration (vr_FinancialSystemIdWarehouse).</description>
        <inlineHelpText>Warehouse this product ships from. Empty = the administration default.</inlineHelpText>
        <label>Warehouse</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>pvs_FinancialSystemWarehouse</valueSetName>
        </valueSet>
    </fields>
    <validationRules>
        <fullName>vr_FinancialSystemIdWarehouse</fullName>
        <active>true</active>
        <description>The warehouse must belong to the administration of this record: the value prefix (before _) is the administration reseller (a dependent picklist is not possible on a lookup).</description>
        <errorConditionFormula>AND(
    NOT(ISBLANK(TEXT(FinancialSystemIdWarehouse__c))),
    NOT(BEGINS(TEXT(FinancialSystemIdWarehouse__c), TEXT(Subscription25__Administration__r.Reseller__c) &amp; &apos;_&apos;))
)</errorConditionFormula>
        <errorDisplayField>FinancialSystemIdWarehouse__c</errorDisplayField>
        <errorMessage>This warehouse does not belong to the administration of this product.</errorMessage>
    </validationRules>
</CustomObject>
