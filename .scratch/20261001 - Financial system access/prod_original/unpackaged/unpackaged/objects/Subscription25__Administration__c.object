    <sharingModel>ReadWrite</sharingModel>
    <validationRules>
        <fullName>vr_FinancialEnitity_None_Not_Allowed</fullName>
        <active>true</active>
        <description>Financial Entity -  None is not Allowed in combination with, Account (Payment Provider), (Synchronisation and Exclude from Jobs))</description>
        <errorConditionFormula>AND(ISPICKVAL(Reseller__c,&apos;0&apos;),OR(NOT(ISBLANK(PayProv_Account__c)),AND(NOT(ISBLANK(TEXT( Subscription25__Synchronisation__c ))),NOT( Subscription25__Exclude_From_Jobs__c ))))</errorConditionFormula>
        <errorDisplayField>Reseller__c</errorDisplayField>
        <errorMessage>Reseller None, doesn&apos;t allow a Payment Provider and Synchronisation to a Financial system is not allowed)</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>vr_Require_Account_Payment_Provider</fullName>
        <active>true</active>
        <errorConditionFormula>AND( PayProv_Use__c , ISBLANK( PayProv_Account__c ))</errorConditionFormula>
        <errorDisplayField>PayProv_Use__c</errorDisplayField>
        <errorMessage>When checked, A account (Payment Provider) is required!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>vr_Require_Direct_Debit_Method</fullName>
        <active>true</active>
        <description>Requires a Direct Debit Method, when the Account (Payment Provider) is set</description>
        <errorConditionFormula>AND( PayProv_Use__c , NOT(ISBLANK( PayProv_Account__c )), ISBLANK(TEXT( PayProv_DirectDebit_PaymentMethod__c )))</errorConditionFormula>
        <errorDisplayField>PayProv_DirectDebit_PaymentMethod__c</errorDisplayField>
        <errorMessage>When using a Payment Provider, a Direct Debit Method is required)</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
