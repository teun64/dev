    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>Acceptance_Environment_Available__c</fullName>
        <defaultValue>false</defaultValue>
        <description>When enabled, this administration has a real acceptance/test environment for its financial system, so Exact sync is allowed to run from a sandbox org. When disabled (default), Exact sync is skipped in sandboxes for this administration to prevent a sandbox from calling the production financial system.</description>
        <label>Acceptance Environment Available</label>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Administration_URL__c</fullName>
        <label>Administration URL</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Url</type>
    </fields>
    <fields>
        <fullName>Available_System_Platforms__c</fullName>
        <description>System platforms (Product2.System_Platform__c) that dealers under this reseller/administration are allowed to see in the Dealer Shop&apos;s &quot;All Products&quot; tab. Blank means no platform restriction is applied for this reseller.</description>
        <label>Available System Platforms</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>MultiselectPicklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetName>System</valueSetName>
        </valueSet>
        <visibleLines>4</visibleLines>
    </fields>
    <fields>
        <fullName>Bank_6_Account_Number__c</fullName>
        <description>Bank Account Number UK</description>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL( Reseller__c, &apos;6&apos;)
,
Right( SUBSTITUTE(Subscription25__IBAN__c, &apos; &apos;, &apos;&apos;)  ,8)
,
&apos;&apos;
)</formula>
        <label>Account Number (Bank)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Bank_6_Sort_Code__c</fullName>
        <description>SortCode Bank</description>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL( Reseller__c, &apos;6&apos;)
,
LEFT(Right( SUBSTITUTE(Subscription25__IBAN__c, &apos; &apos;, &apos;&apos;)  ,14),6)
,
&apos;&apos;
)</formula>
        <label>Sort Code (Bank)</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Business_Entity__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>Points at the Business_Entities__c record for the same reseller (matched via Reseller__c). Added purely for SOQL/report convenience - the two objects are still joined by the shared Reseller__c picklist value, not by this lookup.</description>
        <label>Business Entity</label>
        <referenceTo>Business_Entities__c</referenceTo>
