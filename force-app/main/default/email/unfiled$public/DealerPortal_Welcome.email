<messaging:emailTemplate recipientType="User" language="{!recipient.LanguageLocaleKey}" subject="{!$Label.DealerPortal_EmailWelcomeSubject}">
    <messaging:htmlEmailBody>
        <html>
        <body style="margin:0;padding:0;background:#f4f4f4;font-family:Arial,Helvetica,sans-serif;color:#1a1a1a;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f4;padding:24px 0;">
        <tr><td align="center">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;">
            <tr><td><c:emailLetterheadPreferences part="header" language="{!recipient.LanguageLocaleKey}" /></td></tr>
            <tr><td style="padding:10px;font-family:Arial,sans-serif;font-size:14px;line-height:1.6;color:#1A1A1A;">
                <p style="margin:0 0 16px;"><apex:outputText value="{!$Label.DealerPortal_EmailGreeting}"><apex:param value="{!recipient.FirstName}" /></apex:outputText></p>
                <p style="margin:0 0 16px;">{!$Label.DealerPortal_EmailWelcomeIntro}</p>
                <p style="margin:0 0 16px;"><apex:outputText value="{!$Label.DealerPortal_EmailLoginHint}"><apex:param value="{!recipient.Email}" /></apex:outputText></p>
                <p style="margin:24px 0;"><a href="{!$Network.NetworkUrlForUserEmails}" style="display:inline-block;background:#ff0000;color:#ffffff;text-decoration:none;font-weight:bold;padding:12px 24px;border-radius:4px;">{!$Label.DealerPortal_EmailWelcomeButton}</a></p>
                <p style="margin:0;font-size:13px;color:#555555;">{!$Label.DealerPortal_EmailLinkHint}</p>
                <p style="margin:24px 0 0;"><c:dealerPortalContactEmail userId="{!recipient.Id}" /></p>
                <p style="margin:24px 0 0;">{!$Label.DealerPortal_EmailSignature}<br/><strong>Moving Intelligence</strong></p>
                <c:emailLetterheadPreferences part="logo" language="{!recipient.LanguageLocaleKey}" />
            </td></tr>
            <tr><td><c:emailLetterheadPreferences part="footer" language="{!recipient.LanguageLocaleKey}" /></td></tr>
        </table>
        </td></tr>
        </table>
        </body>
        </html>
    </messaging:htmlEmailBody>
</messaging:emailTemplate>
