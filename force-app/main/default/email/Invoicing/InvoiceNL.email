<a href="https://movingintelligence.nl" style="font-family:Arial,Helvetica,sans-serif; color:#5B625B">movingintelligence.nl</a></div>
</div>


<div style="font-family:Arial,Helvetica,sans-serif; margin:24px 0 8px 0; padding-top:12px; border-top:1px solid #E0E0E0; font-size:11px; line-height:18px; color:#8A8F8A;">
    <strong style="font-family:Arial,Helvetica,sans-serif; color:#8A8F8A;">{{{Subscription25__Invoice__c.Legal_Name__c}}}</strong><br/>
    {{{Subscription25__Invoice__c.Legal_Address__c}}}<br/>
