                    "lightning:typography" : "{!$brand.typography.heading.heading2}",
                    "text" : "<strong>Wij staan klaar voor als het nodig is<br /></strong>"
                  },
                  "definition" : "lightning/heading",
                  "id" : "e6c8d1ee-eee3-4485-9f42-3fdddb154098",
                  "type" : "block"
                },
                {
                  "attributes" : {
                    "align" : "left",
                    "lightning:borderRadius" : "{!$brand.borderRadius.square}",
                    "lightning:borderWidth" : "{!$brand.borderWeight.none}",
                    "lightning:colorGroup" : {
                      "backgroundColor" : "{!$brand.colorScheme.root}",
                      "borderColor" : "{!$brand.colorScheme.neutral}",
                      "linkColor" : "{!$brand.colorScheme.primaryAccent}",
                      "textColor" : "{!$brand.colorScheme.contrast}"
                    },
                    "lightning:margin" : "{!$brand.spacing.none}",
                    "lightning:padding" : "{!$brand.spacing.xSmall}",
                    "lightning:typography" : "{!$brand.typography.paragraph.paragraph1}",
                    "text" : "Heeft u notificaties ingesteld? Wilt u dagelijks weten waar uw voertuig is? Of alleen maar wanneer uw auto, motor, camper, boot niet meer daar is waar die moet zijn? De Peilzender is het ultieme terugvindsysteem waar u al ruim twee jaar op vertrouwt. Al 750 dagen staan wij klaar om uw voertuig terug te vinden, wanneer dat nodig is. <br /> <br />Uw Peilzender blijft nog wel een tijdje doorgaan. In de MiApp kunt u zien hoe lang de batterij nog meegaat. Onder normale omstandigheden hoeft de Peilzender voorlopig nog niet vervangen te worden.<br />"
                  },
