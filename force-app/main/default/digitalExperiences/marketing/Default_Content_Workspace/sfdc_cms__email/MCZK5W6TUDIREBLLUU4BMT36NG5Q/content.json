                    "lightning:typography" : "{!$brand.typography.heading.heading2}",
                    "text" : "<strong>Peilzender ook voor camper, klassieker en boot</strong>"
                  },
                  "definition" : "lightning/heading",
                  "id" : "b69bf3a5-7e2c-4f77-be2d-d160f4a0a27e",
                  "type" : "block"
                },
                {
                  "attributes" : {
                    "align" : "left",
                    "lightning:borderRadius" : "{!$brand.borderRadius.square}",
                    "lightning:borderWidth" : "{!$brand.borderWeight.none}",
                    "lightning:colorGroup" : {
                      "backgroundColor" : "{!$brand.colorScheme.root}",
                      "borderColor" : "{!$brand.colorScheme.neutral}",
                      "linkColor" : "{!$brand.colorScheme.primaryAccent}",
                      "textColor" : "{!$brand.colorScheme.contrast}"
                    },
                    "lightning:margin" : "{!$brand.spacing.none}",
                    "lightning:padding" : "{!$brand.spacing.xSmall}",
                    "lightning:typography" : "{!$brand.typography.paragraph.paragraph1}",
                    "text" : "Wist u dat we ook een Peilzender kunnen inbouwen in uw motor, boot, camper, caravan, aanhanger, klassieke auto of werkmaterieel? Het terugvindsysteem is geschikt voor (bijna) alles wat beweegt. Of wat juist stilstaat in de stalling. Ook bij deze objecten kunt u rekenen op het Recovery Team. Vraag uw dealer of verzekeraar naar de mogelijkheden, SCM-eisen vanuit de verzekeraars en eventuele kortingsacties. Of neem direct contact op met Moving Intelligence: &#43;31 88 99 000 00. "
                  },
                  "definition" : "lightning/paragraph",
                  "id" : "c29b63b6-00fd-4fa4-b112-62e32cd1a6e1",
                  "type" : "block"
