                    "lightning:typography" : "{!$brand.typography.heading.heading2}",
                    "text" : "<strong>Mi-klanten vertellen</strong>"
                  },
                  "definition" : "lightning/heading",
                  "id" : "9254eb66-e95f-434a-8f1a-2fc6e2a4ba9c",
                  "type" : "block"
                },
                {
                  "attributes" : {
                    "align" : "left",
                    "lightning:borderRadius" : "{!$brand.borderRadius.square}",
                    "lightning:borderWidth" : "{!$brand.borderWeight.none}",
                    "lightning:colorGroup" : {
                      "backgroundColor" : "{!$brand.colorScheme.root}",
                      "borderColor" : "{!$brand.colorScheme.neutral}",
                      "linkColor" : "{!$brand.colorScheme.primaryAccent}",
                      "textColor" : "{!$brand.colorScheme.contrast}"
                    },
                    "lightning:margin" : "{!$brand.spacing.none}",
                    "lightning:padding" : "{!$brand.spacing.xSmall}",
                    "lightning:typography" : "{!$brand.typography.paragraph.paragraph1}",
                    "text" : "&#34;Ik ben geweldig geholpen door een medewerker van Moving Intelligence, die zelfs helemaal naar Alicante is gevolgen met zijn apparatuur om onze gestolen auto terug te vinden. Dat lukte binnen 2 uur!  Hij is zelfs bij onze auto gebleven toen wij naar het politiebureau moesten.” - <em>Annemieke</em> <br /><br />Dit is één van de mooie verhalen die we dagelijks horen na geslaagde recovery&#39;s. We nemen alle zorgen uit handen en halen uw auto terug, ook uit het buitenland. Ook zetten we alles op alles om u te helpen met (technische) vragen over uw Peilzender:<br /><br />&#34;Altijd goed bereikbaar ,vakkundige mensen die je helpen om alles in goede banen te leiden. Zeer tevreden en aan te bevelen.&#34; - <em>Henk-Willem</em>"
                  },
