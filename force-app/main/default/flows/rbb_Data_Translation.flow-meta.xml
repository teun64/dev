<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>53.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>ass_01_Composite_Key</name>
        <label>1. Composite Key</label>
        <locationX>50</locationX>
        <locationY>551</locationY>
        <assignmentItems>
            <assignToReference>$Record.Composite_Key__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fCompositeKey</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>ass_01_Source_ID</name>
        <label>1. Source ID</label>
        <locationX>182</locationX>
        <locationY>311</locationY>
        <assignmentItems>
            <assignToReference>$Record.Source_Id__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fSourceId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>dec_01_Composite_Key</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Set the composite key?</description>
        <name>dec_01_Composite_Key</name>
        <label>1. Composite Key</label>
        <locationX>182</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Skip</defaultConnectorLabel>
        <rules>
            <name>dec_01_Composite_Key_Set</name>
            <conditionLogic>(1 AND 2 AND 3) OR (4 AND 5 AND 6) OR 7</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Language__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Language__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Language__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Source_Id__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.Source_Id__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Source_Id__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Source_Id__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>ass_01_Composite_Key</targetReference>
            </connector>
            <label>Set</label>
        </rules>
    </decisions>
    <description>Generic flow for data translations: Source Id (the product, otherwise the campaign) and the composite key</description>
    <formulas>
        <name>fCompositeKey</name>
        <dataType>String</dataType>
        <expression>{!$Record.Source_Id__c} + TEXT({!$Record.Language__c})</expression>
    </formulas>
    <formulas>
        <name>fSourceId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Product__c} ),IF(ISBLANK({!$Record.Campaign__c}), &apos;&apos;, {!$Record.Campaign__c}), {!$Record.Product__r.Id} )</expression>
    </formulas>
    <interviewLabel>rbb - Data Translation {!$Flow.CurrentDateTime}</interviewLabel>
    <label>rbb - Data Translation</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>ass_01_Source_ID</targetReference>
        </connector>
        <object>Data_Translation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
