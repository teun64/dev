    <description>Keeps Business_Entities__c in sync with the non-package custom fields on Subscription25__Administration__c, matched by the shared Reseller__c picklist value. One-way sync (Administration -&gt; Business Entity) only - does not write back to Administration. Apex/Flow logic that currently reads these fields from Administration is NOT migrated by this flow; that cutover happens deliberately, field by field, not automatically.</description>
    <environments>Default</environments>
    <formulas>
        <name>fx_Bank_6_Account_Number</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Reseller__c}, &quot;6&quot;), RIGHT(SUBSTITUTE({!$Record.Subscription25__IBAN__c}, &quot; &quot;, &quot;&quot;), 8), &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>fx_Bank_6_Sort_Code</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Reseller__c}, &quot;6&quot;), LEFT(RIGHT(SUBSTITUTE({!$Record.Subscription25__IBAN__c}, &quot; &quot;, &quot;&quot;), 14), 6), &quot;&quot;)</expression>
    </formulas>
    <interviewLabel>Sync Administration to Business Entity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sync Administration to Business Entity</label>
