<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>Sends the direct debit setup email when a new psp-dd payment is created and the account does not yet have an active mandate. Delegates to afl_Payment_Direct_Debit_Setup which generates the token (externalId__c) and sends the email.</description>
    <environments>Default</environments>
    <interviewLabel>rab - Payment - Direct Debit - Setup {!$Flow.CurrentDateTime}</interviewLabel>
    <label>rab - Payment - Direct Debit - Setup</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Setup</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>psp-dd</stringValue>
            </value>
        </filters>
        <filters>
            <field>externalId__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Payment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>sub_01_DirectDebitSetup</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>sub_01_DirectDebitSetup</name>
        <label>1. Direct Debit Setup</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>afl_Payment_Direct_Debit_Setup</flowName>
        <inputAssignments>
            <name>paymentRecord</name>
            <value>
                <elementReference>$Record</elementReference>
            </value>
        </inputAssignments>
        <outputAssignments>
            <assignToReference>vAlertMessage</assignToReference>
            <name>AlertMessage</name>
        </outputAssignments>
    </subflows>
    <triggerOrder>200</triggerOrder>
    <variables>
        <name>vAlertMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
