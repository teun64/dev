    <screens>
        <name>scr_01_NotAllowed</name>
        <label>1. Not Allowed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dt_01_NotAllowed</name>
            <fieldText>&lt;p&gt;&lt;strong&gt;The termination of contract {!rContract.ContractNumber} can&apos;t be undone.&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;This is only possible for a Terminated or Closed contract, up to 7 days after the termination date, when the termination is not already reverted, and for users with the permission set miContractUndoTermination or System Administrators.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>scr_02_Confirmation</name>
        <label>2. Confirmation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>dur_03_Contract</targetReference>
        </connector>
        <fields>
            <name>dt_02_Confirmation</name>
            <fieldText>&lt;p&gt;&lt;strong style=&quot;font-size: 16px;&quot;&gt;Undo the termination of contract {!rContract.ContractNumber}?&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;Status: {!rContract.Status}&lt;/p&gt;&lt;p&gt;Termination date: {!rContract.Subscription25__Termination_Date__c}&lt;/p&gt;&lt;p&gt;Service end date: {!rContract.Service_End_Date__c}&lt;/p&gt;&lt;p&gt;Termination method: {!rContract.Termination_Method__c}&lt;/p&gt;&lt;p&gt;Contract products with the same termination date: {!vContractProductCount}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;The termination method becomes &quot;Termination Reverted&quot;. The termination date and service end date are cleared and the status is set to Activated, on the contract and (in the background) on these contract products, which are also included in corrections again. The draft credit order is deleted, an invoiced one is reversed.&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;color: rgb(215, 4, 4);&quot;&gt;The MI platform is not updated.&lt;/span&gt;&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <nextOrFinishButtonLabel>Undo Termination</nextOrFinishButtonLabel>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
        <name>scr_05_Done</name>
        <label>5. Done</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>dt_05_Done</name>
            <fieldText>&lt;p&gt;The termination of contract {!rContract.ContractNumber} is undone. The contract products ({!vContractProductCount}) and the credit order are handled in the background, refresh the page in a moment.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>false</showHeader>
    </screens>
    <screens>
