    <description>Runs after update, only when the debtor number is set / changed or the financial entity (reseller) changes.
Keeps the one Subscription25 Debtor Number of the account (composite key = Account Id + Administration Id) in line with the Account:
- the administration follows the financial entity (Reseller_Name__c; reseller 3 = administration 1). Debtor numbers of another administration are deleted: only one record per account is allowed (Subscription25 always takes the first one).
- Subscription25__Debtor_Number__c = Account.FinancialDebtorNumber__c.
- Exact ids are taken over from the Account when the debtor number has none yet, or when the Account value changed in the same save: Exact_ID__c = FinancialIdAccount__c, Exact_Invoice_Address_ID__c = FinancialIdInvoiceAddress__c, Exact_Bank_Account_ID__c = FinancialIdBankAccount__c, Exact_Mandate_ID__c = FinancialIdBankMandate__c.
- NOTE: Exact_Contact_ID__c = FinancialIdContact__c of the AccountContactRelation with the role Invoice (isInvoiceContact__c = true); taken over when empty or when the Exact account changed.
Errors are written to Account.FinancialSyncLastError__c, so the account save (e.g. by the financial system sync) never fails on the debtor number.</description>
    <environments>Default</environments>
    <formulas>
        <name>fAdministrationExternalId</name>
        <dataType>Number</dataType>
        <expression>IF(TEXT({!$Record.Reseller_Name__c}) = &apos;3&apos;, 1, VALUE(TEXT({!$Record.Reseller_Name__c})))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <name>fCompositeKey</name>
        <dataType>String</dataType>
        <expression>CASESAFEID({!$Record.Id}) &amp; CASESAFEID({!rAdministration.Id})</expression>
    </formulas>
    <formulas>
        <name>fExactBankAccountId</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK({!$Record.FinancialIdBankAccount__c})), OR(ISBLANK({!rDebtorNumber.Exact_Bank_Account_ID__c}), {!$Record.FinancialIdBankAccount__c} &lt;&gt; {!$Record__Prior.FinancialIdBankAccount__c})), {!$Record.FinancialIdBankAccount__c}, {!rDebtorNumber.Exact_Bank_Account_ID__c})</expression>
    </formulas>
    <formulas>
        <name>fExactContactId</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK({!rAccountContactRelation.FinancialIdContact__c})), OR(ISBLANK({!rDebtorNumber.Exact_Contact_ID__c}), {!$Record.FinancialIdAccount__c} &lt;&gt; {!$Record__Prior.FinancialIdAccount__c})), {!rAccountContactRelation.FinancialIdContact__c}, {!rDebtorNumber.Exact_Contact_ID__c})</expression>
    </formulas>
    <formulas>
        <name>fExactId</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK({!$Record.FinancialIdAccount__c})), OR(ISBLANK({!rDebtorNumber.Exact_ID__c}), {!$Record.FinancialIdAccount__c} &lt;&gt; {!$Record__Prior.FinancialIdAccount__c})), {!$Record.FinancialIdAccount__c}, {!rDebtorNumber.Exact_ID__c})</expression>
    </formulas>
    <formulas>
        <name>fExactInvoiceAddressId</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK({!$Record.FinancialIdInvoiceAddress__c})), OR(ISBLANK({!rDebtorNumber.Exact_Invoice_Address_ID__c}), {!$Record.FinancialIdInvoiceAddress__c} &lt;&gt; {!$Record__Prior.FinancialIdInvoiceAddress__c})), {!$Record.FinancialIdInvoiceAddress__c}, {!rDebtorNumber.Exact_Invoice_Address_ID__c})</expression>
    </formulas>
    <formulas>
        <name>fExactMandateId</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT(ISBLANK({!$Record.FinancialIdBankMandate__c})), OR(ISBLANK({!rDebtorNumber.Exact_Mandate_ID__c}), {!$Record.FinancialIdBankMandate__c} &lt;&gt; {!$Record__Prior.FinancialIdBankMandate__c})), {!$Record.FinancialIdBankMandate__c}, {!rDebtorNumber.Exact_Mandate_ID__c})</expression>
    </formulas>
    <formulas>
        <name>fFaultMessage</name>
        <dataType>String</dataType>
        <expression>LEFT(&apos;Debtor number: &apos; &amp; {!$Flow.FaultMessage}, 255)</expression>
    </formulas>
