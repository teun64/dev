    <formulas>
        <description>Opportunity campaign: the Offer campaign next to the Case campaign (staged campaign), otherwise the Case campaign.</description>
        <name>fCampaignId</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!rOfferCampaign.Id}), {!recordId.Campaign__c}, {!rOfferCampaign.Id})</expression>
    </formulas>
    <formulas>
        <name>fDefaultCloseDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
    <formulas>
        <name>fDefaultName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!recordId.Campaign__c}), {!recordId.CaseNumber}, BLANKVALUE({!recordId.Campaign__r.CallbackLabel__c}, {!recordId.Campaign__r.Name})) &amp; &apos; - &apos; &amp; {!recordId.Account.Name}</expression>
    </formulas>
