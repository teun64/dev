<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Background_Color_Format</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(Background_Color__c, &quot;#[0-9A-Fa-f]{6}&quot;))</errorConditionFormula>
    <errorMessage>Background Color must be a hex color in the format #0E0F0E.</errorMessage>
</ValidationRule>
