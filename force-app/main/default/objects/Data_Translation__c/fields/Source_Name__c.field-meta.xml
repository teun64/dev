<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Source_Name__c</fullName>
    <description>Generic source name field: the product name, otherwise the campaign name</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Product__c), IF(ISBLANK(Campaign__c), &apos;&apos;, Campaign__r.Name), Product__r.Name)</formula>
    <label>Source Name</label>
    <required>false</required>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
