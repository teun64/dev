<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Address__c</fullName>
    <description>Mirror of the Business Entity data, for the service email footer (a template can merge one relationship hop only).</description>
    <externalId>false</externalId>
    <formula>Business_Entity__r.Address__Street__s &amp; ', ' &amp; Business_Entity__r.Address__PostalCode__s &amp; ' ' &amp; Business_Entity__r.Address__City__s &amp; ', ' &amp; CASE(TEXT(Business_Entity__r.Address__CountryCode__s), 'NL','Netherlands', 'DE','Germany', 'GB','United Kingdom', 'BE','Belgium', 'FR','France', 'GR','Greece', TEXT(Business_Entity__r.Address__CountryCode__s))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Address</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
