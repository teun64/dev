<apex:component access="global" controller="Ctrl_EmailLetterheadFooter">
    <apex:attribute name="part" type="String" description="header | logo | footer" />
    <apex:attribute name="language" type="String" assignTo="{!emailLanguage}" description="Language code of the email (nl, de, fr, en; nl_NL etc. also works); anything else falls back to English. Pass $Label.DealerPortal_EmailLanguage: recipient fields are empty when a guest sends the email (forgot password)." />
    <apex:attribute name="personalLinks" type="Boolean" default="true" description="Footer part: show the notice that the email contains personal links (false for mails without a personal link)." />
    <!-- Copy of the Enhanced Letterheads lh_M_Preferences_EN/NL/DE/FR for Visualforce email templates, which cannot use a letterhead. Keep both in sync. -->
    <apex:variable var="lang" value="{!LOWER(LEFT(language, 2))}" />

    <apex:outputPanel layout="none" rendered="{!part == 'header'}">
        <div><img alt="mi-email-header" src="https://movingintelligence.file.force.com/file-asset-public/miemailheader?oid=00D1t000000uTfK" style="max-width: 600px; width: 100%; display: block;" title="mi-email-header" /></div>
    </apex:outputPanel>

    <apex:outputPanel layout="none" rendered="{!part == 'logo'}">
        <div style="margin:24px 0 0 0; font-family:Arial,Helvetica,sans-serif;">
            <div style="margin-bottom:10px;"><img alt="mi-logo-black" src="https://movingintelligence.file.force.com/file-asset-public/milogoblack?oid=00D1t000000uTfK" style="width: 180px" title="mi-logo-black" /></div>
            <div style="width:20px; border-top:2px solid #FF0000; font-size:0; line-height:0; margin-bottom:10px;">&#160;</div>
            <div style="font-family:Arial,Helvetica,sans-serif; font-weight:400; font-size:14px; line-height:20px; color:#5B625B;"><strong>knowledge in motion<span style="color:#FF0000;">.</span></strong><br />
                <apex:outputPanel layout="none" rendered="{!lang == 'nl'}"><a href="https://movingintelligence.nl" style="color:#5B625B">movingintelligence.nl</a></apex:outputPanel>
                <apex:outputPanel layout="none" rendered="{!lang == 'de'}"><a href="https://movingintelligence.de" style="color:#5B625B">movingintelligence.de</a></apex:outputPanel>
                <apex:outputPanel layout="none" rendered="{!lang == 'fr'}"><a href="https://movingintelligence.ai" style="color:#5B625B">movingintelligence.ai</a></apex:outputPanel>
                <apex:outputPanel layout="none" rendered="{!NOT(OR(lang == 'nl', lang == 'de', lang == 'fr'))}"><a href="https://movingintelligence.co.uk" style="color:#5B625B">movingintelligence.co.uk</a></apex:outputPanel>
            </div>
        </div>
    </apex:outputPanel>

    <apex:outputPanel layout="none" rendered="{!part == 'footer'}">
        <apex:outputPanel layout="none" rendered="{!lang == 'nl'}"><div style="padding: 0px 10px 10px 10px; font-family:Arial,Helvetica,sans-serif; font-size: 11px; line-height: 18px; color: #8A8F8A;">
            <strong>{!entity.Business_Name__c}</strong><br />{!addressLine}<br />KvK {!entity.CoC_Number__c} &#183; BTW {!entity.VAT_Number__c}<br /><br />
            U ontvangt dit bericht omdat u klant bent van Moving Intelligence en het betrekking heeft op uw dienstverlening.<br /><br />
            <apex:outputPanel layout="none" rendered="{!personalLinks}">Deze e-mail bevat persoonlijke links. Stuur hem daarom niet door.<br /><br /></apex:outputPanel>
            Op al onze diensten zijn onze algemene voorwaarden van toepassing. Lees onze <a href="{!entity.Terms_Conditions_URL__c}" style="color:#5B625B;">algemene voorwaarden</a> en <a href="{!entity.Privacy_Policy_URL__c}" style="color:#5B625B;">privacyverklaring</a>.
        </div></apex:outputPanel>
        <apex:outputPanel layout="none" rendered="{!lang == 'de'}"><div style="padding: 0px 10px 10px 10px; font-family:Arial,Helvetica,sans-serif; font-size: 11px; line-height: 18px; color: #8A8F8A;">
            <strong>{!entity.Business_Name__c}</strong><br />{!addressLine}<br />Handelsregister {!entity.CoC_Number__c} &#183; USt-IdNr. {!entity.VAT_Number__c}<br />Geschäftsführer: {!entity.Managing_directors__c}<br /><br />
            Sie erhalten diese Nachricht, weil Sie Kunde von Moving Intelligence sind und sie Ihren Vertrag betrifft.<br /><br />
            <apex:outputPanel layout="none" rendered="{!personalLinks}">Diese E-Mail enthält persönliche Links. Bitte leiten Sie sie nicht weiter.<br /><br /></apex:outputPanel>
            Für alle unsere Leistungen gelten unsere Allgemeinen Geschäftsbedingungen. Lesen Sie unsere <a href="{!entity.Terms_Conditions_URL__c}" style="color:#5B625B;">AGB</a> und unsere <a href="{!entity.Privacy_Policy_URL__c}" style="color:#5B625B;">Datenschutzerklärung</a>.
        </div></apex:outputPanel>
        <apex:outputPanel layout="none" rendered="{!lang == 'fr'}"><div style="padding: 0px 10px 10px 10px; font-family:Arial,Helvetica,sans-serif; font-size: 11px; line-height: 18px; color: #8A8F8A;">
            <strong>{!entity.Business_Name__c}</strong><br />{!addressLine}<br />RCS {!entity.CoC_Number__c} &#183; TVA {!entity.VAT_Number__c}<br /><br />
            Vous recevez ce message car vous êtes client de Moving Intelligence et qu'il concerne votre service.<br /><br />
            <apex:outputPanel layout="none" rendered="{!personalLinks}">Cet e-mail contient des liens personnels. Merci de ne pas le transférer.<br /><br /></apex:outputPanel>
            Nos conditions générales s'appliquent à l'ensemble de nos services. Consultez nos <a href="{!entity.Terms_Conditions_URL__c}" style="color:#5B625B;">conditions générales</a> et notre <a href="{!entity.Privacy_Policy_URL__c}" style="color:#5B625B;">déclaration de confidentialité</a>.
        </div></apex:outputPanel>
        <apex:outputPanel layout="none" rendered="{!NOT(OR(lang == 'nl', lang == 'de', lang == 'fr'))}"><div style="padding: 0px 10px 10px 10px; font-family:Arial,Helvetica,sans-serif; font-size: 11px; line-height: 18px; color: #8A8F8A;">
            <strong>{!entity.Business_Name__c}</strong><br />{!addressLine}<br />Company no. {!entity.CoC_Number__c} &#183; VAT {!entity.VAT_Number__c}<br /><br />
            You are receiving this message because you are a customer of Moving Intelligence and it relates to your service.<br /><br />
            <apex:outputPanel layout="none" rendered="{!personalLinks}">This email contains personal links. Please do not forward it.<br /><br /></apex:outputPanel>
            Our general terms and conditions apply to all our services. Read our <a href="{!entity.Terms_Conditions_URL__c}" style="color:#5B625B;">terms and conditions</a> and <a href="{!entity.Privacy_Policy_URL__c}" style="color:#5B625B;">privacy statement</a>.
        </div></apex:outputPanel>
    </apex:outputPanel>
</apex:component>
